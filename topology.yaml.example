# Reticle operational graph example
# Static topology is local and git-diffable. Collectors produce signals;
# callers may request only server-owned named actions, never shell text.
# The viewer graph API, MCP, and chat expose no interactive or ad-hoc shell.
version: 1

nodes:
  web-01:
    kind: server
    title: web-01
    subtitle: "nginx · 10.0.1.4"
    x: 60
    y: 80
    w: 220
    h: 120
    spec: { host: 10.0.1.4, port: 22, user: reticle-probe }
    notes: "Public web entry point"
  db-primary:
    kind: database
    title: db-primary
    subtitle: "postgres · 10.0.2.3"
    x: 200
    y: 280
    w: 220
    h: 120
    spec: { host: 10.0.2.3, port: 22, user: reticle-probe }

edges:
  e_web_db:
    kind: tcp
    label: tcp/5432
    from: web-01
    to: db-primary

collectors:
  - id: web-http
    nodeId: web-01
    name: Web health endpoint
    kind: http
    url: https://web.example.com/healthz
    status: 2xx
    jq: '.status == "ok"'
    timeoutSeconds: 8
  - id: postgres-service
    nodeId: db-primary
    name: PostgreSQL service
    kind: ssh
    probe: service.status
    service: postgresql.service
    timeoutSeconds: 10
  # WARNING: ssh.command is an arbitrary remote command and cannot be guaranteed
  # read-only. Team requires daemon --allow-custom-commands plus editor
  # management. The UI defaults enabled/publishOutput to true; this example
  # explicitly disables both. Use a restricted SSH principal or forced command.
  - id: postgres-replication-check
    nodeId: db-primary
    name: PostgreSQL replication check
    kind: ssh
    probe: ssh.command
    command: /usr/local/libexec/reticle-check postgres-replication
    enabled: false
    publishOutput: false
    timeoutSeconds: 10

actions:
  - id: inspect-postgres
    nodeId: db-primary
    name: Inspect PostgreSQL
    kind: ssh.command
    command: pg_isready && psql -Atqc 'select now()'
    requiresSignal: postgres-service
    requiresState: err
    requiresApproval: true
    timeoutSeconds: 20

groups: []
layers: []
