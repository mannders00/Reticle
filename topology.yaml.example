# Reticle operational graph example
# Static topology is local and git-diffable. Collectors produce signals;
# callers may request only server-owned named actions, never shell text.
# Use least-privilege SSH credentials; JSON API, MCP, and chat expose no shell.
version: 1

nodes:
  web-01:
    kind: server
    title: web-01
    subtitle: "nginx · 10.0.1.4"
    x: 60
    y: 80
    w: 220
    h: 120
    spec: { host: 10.0.1.4, port: 22, user: reticle-probe }
    notes: "Public web entry point"
  db-primary:
    kind: database
    title: db-primary
    subtitle: "postgres · 10.0.2.3"
    x: 200
    y: 280
    w: 220
    h: 120
    spec: { host: 10.0.2.3, port: 22, user: reticle-probe }

edges:
  e_web_db:
    kind: tcp
    label: tcp/5432
    from: web-01
    to: db-primary

collectors:
  - id: web-http
    nodeId: web-01
    name: Web health endpoint
    kind: http
    url: https://web.example.com/healthz
    status: 2xx
    jq: '.status == "ok"'
    timeoutSeconds: 8
  - id: postgres-service
    nodeId: db-primary
    name: PostgreSQL service
    kind: ssh
    probe: service.status
    service: postgresql.service
    timeoutSeconds: 10

actions:
  - id: restart-postgres
    nodeId: db-primary
    name: Restart PostgreSQL
    kind: service.restart
    service: postgresql.service
    requiresSignal: postgres-service
    requiresState: err
    requiresApproval: true
    timeoutSeconds: 20

groups: []
layers: []
